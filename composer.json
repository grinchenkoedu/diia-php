{
  "name": "grinchenkoedu/diia-php",
  "description": "Diia (Дія) API client for PHP",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Yevhen Matasar",
      "email": "matasar.ei@gmail.com"
    }
  ],
  "require": {
    "php": "^7.4 || ^8.0",
    "guzzlehttp/guzzle": "^7.8",
    "psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
    "psr/log": "^1.1 || ^2.0 || ^3.0",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "GrinchenkoUniversity\\Diia\\": "src/"
    }
